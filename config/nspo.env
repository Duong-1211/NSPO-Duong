# Safety dataset preparation
PKU_DATASET_ID=PKU-Alignment/PKU-SafeRLHF
PKU_DATASET_CONFIG=default
PKU_DATASET_REVISION=9421ffafec3fa40a1f1a7d567b4d525079477ecb
SAFETY_TRAIN_SIZE=8000
SAFETY_VAL_SIZE=1000
SAFETY_DATA_SEED=42
SAFETY_DEDUPLICATE_PROMPTS=true
SAFETY_OUTPUT_DIR=data/safety/pku_saferlhf_8k
SAFETY_TRAIN_FILE=SafeRLHFfull_safety.parquet
SAFETY_VAL_FILE=SafeRLHFfull_test_safety.parquet

# Policy model and preservation data
MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct
PRESERVATION_DATA_PATH=data/preservation/nspo_mix/prompts.jsonl

# Compact safety reward model
REWARD_MODEL_PATH=meta-llama/Llama-Guard-3-1B
REWARD_MODEL_NAME=Llama-Guard-3-1B
REWARD_HOST=127.0.0.1
REWARD_PORT=52001
REWARD_API_BASE=http://127.0.0.1:52001/v1
REWARD_API_KEY=EMPTY
REWARD_CUDA_VISIBLE_DEVICES=1
REWARD_GPU_MEMORY_UTILIZATION=0.6
REWARD_TENSOR_PARALLEL_SIZE=1
REWARD_MAX_MODEL_LEN=4096
REWARD_MAX_WORKERS=16
REWARD_TEMPERATURE=0.0
REWARD_MAX_TOKENS=16

# Single-node training runtime
TRAIN_CUDA_VISIBLE_DEVICES=0
TRAIN_N_GPUS_PER_NODE=1
TRAIN_LOGGER=console
